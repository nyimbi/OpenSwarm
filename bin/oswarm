#!/usr/bin/env bash
# oswarm — personal launcher for the local OpenSwarm fork.
#
# Sources secrets (via a strict KEY=VALUE parser, NOT raw `source`),
# bridges shell env-var conventions (AZURE_OPENAI_*) to OpenSwarm's
# LiteLLM-style names (AZURE_*), points web tools at the connectors
# server, and runs swarm.py / server.py from the repo root.
#
# Symlinked to ~/.local/bin/oswarm so it works from any directory.
#
# Usage:
#   oswarm                       launch default swarm (metaswarm)
#   oswarm <slug>                launch a specific swarm
#   oswarm list                  list registered swarms with descriptions
#   oswarm server                FastAPI mode (every swarm at its own URL)
#   oswarm help                  show this usage
#
# Env knobs:
#   OSWARM_SKIP_PROBE=1          skip the SearXNG / Firecrawl reachability check

set -euo pipefail

# Resolve the repo root from the script's actual location (not $PWD,
# which could be anywhere when invoked through the symlink).
SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  SCRIPT="$(readlink "$SCRIPT")"
done
REPO_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

cd "$REPO_ROOT"

# 1. Strict-parse secrets if present.
#
# Historically this was `source "$SECRETS"`, which evaluated whatever
# bash syntax was inside the file (including command substitutions).
# The parser at swarms/_common/secrets_parser.py accepts only
# `KEY=VALUE` lines with KEY in uppercase-identifier shape and VALUE
# free of `;`, backticks, `$(`, `&&`, `||`, newlines.
SECRETS="${HOME}/.config/secrets/api_keys.env"
if [[ -f "$SECRETS" ]]; then
  while IFS=$'\t' read -r _key _value; do
    [[ -n "$_key" ]] && export "$_key=$_value"
  done < <(python3 "${REPO_ROOT}/swarms/_common/secrets_parser.py" "$SECRETS")
fi

# 2. Bridge env-var naming conventions
[[ -n "${AZURE_OPENAI_API_KEY:-}" ]]     && export AZURE_API_KEY="$AZURE_OPENAI_API_KEY"
[[ -n "${AZURE_OPENAI_BASE_URL:-}" ]]    && export AZURE_API_BASE="${AZURE_OPENAI_BASE_URL%/}"
[[ -n "${AZURE_OPENAI_API_VERSION:-}" ]] && export AZURE_API_VERSION="$AZURE_OPENAI_API_VERSION"

# Anthropic-on-Foundry: build the /anthropic endpoint from the resource name
if [[ -n "${ANTHROPIC_FOUNDRY_API_KEY:-}" && -n "${ANTHROPIC_FOUNDRY_RESOURCE:-}" ]]; then
  export AZURE_AI_API_KEY="$ANTHROPIC_FOUNDRY_API_KEY"
  export AZURE_AI_API_BASE="https://${ANTHROPIC_FOUNDRY_RESOURCE}.services.ai.azure.com/anthropic"
fi

# Default model (override via DEFAULT_MODEL env or in-session SwitchProvider)
export DEFAULT_MODEL="${DEFAULT_MODEL:-azure/gpt-4o}"

# Connectors server (SearXNG + Firecrawl) for WebSearch + WebFetch tools.
# Defaults assume the same machine; override with SEARXNG_URL / FIRECRAWL_URL
# for shared infra. The hard-coded private IP that used to live here moved
# to user environment in fix-all-issues Commit 5 (H4).
export SEARXNG_URL="${SEARXNG_URL:-http://localhost:8888}"
export FIRECRAWL_URL="${FIRECRAWL_URL:-http://localhost:3002}"

# 3. Connectivity probe — warn (don't fail) if the web-tool endpoints
#    aren't responding. Two-second timeout each. Gate via OSWARM_SKIP_PROBE=1.
if [[ "${OSWARM_SKIP_PROBE:-0}" != "1" ]]; then
  if command -v curl >/dev/null 2>&1; then
    if ! curl -sf --max-time 2 "${SEARXNG_URL}/healthz" >/dev/null 2>&1; then
      echo "oswarm: warning — SearXNG at ${SEARXNG_URL} did not respond. WebSearch will fail until it does. Set OSWARM_SKIP_PROBE=1 to silence." >&2
    fi
    if ! curl -sf --max-time 2 "${FIRECRAWL_URL}/health" >/dev/null 2>&1; then
      echo "oswarm: warning — Firecrawl at ${FIRECRAWL_URL} did not respond. WebFetch will fail until it does. Set OSWARM_SKIP_PROBE=1 to silence." >&2
    fi
  fi
fi

# 4. Dispatch
ARG="${1:-}"
case "$ARG" in
  help|--help|-h)
    sed -n '2,19p' "$SCRIPT"
    ;;
  server)
    echo "Launching FastAPI on :8080. All swarms exposed at /<slug>/..."
    exec python server.py
    ;;
  list|ls)
    python -c "from swarms import SWARMS; [print(f'  {s:25s} {d}') for s, (_,d) in SWARMS.items()]"
    ;;
  "")
    echo "Launching default swarm (metaswarm). Provider: $DEFAULT_MODEL"
    exec python swarm.py
    ;;
  *)
    export OPENSWARM_SWARM="$ARG"
    echo "Launching swarm: $ARG. Provider: $DEFAULT_MODEL"
    exec python swarm.py
    ;;
esac
